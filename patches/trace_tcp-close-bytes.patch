diff --git a/trace_tcp/ebpf/close.h b/trace_tcp/ebpf/close.h
index 1c6e4dd..87b4d0f 100644
--- a/trace_tcp/ebpf/close.h
+++ b/trace_tcp/ebpf/close.h
@@ -43,6 +43,15 @@ static __always_inline void handle_tcp_close(struct pt_regs *ctx,
 
 	fill_event(event, &tuple, NULL, 0, close);
 
+	// Lifetime counters of the socket, only final once it closes. bytes_sent
+	// counts retransmissions too (what left the host; bytes_acked would be
+	// the payload the peer received), bytes_received is in-order payload.
+	struct tcp_sock *tp = (struct tcp_sock *)sk;
+	if (bpf_core_field_exists(tp->bytes_sent))
+		event->bytes_sent = BPF_CORE_READ(tp, bytes_sent);
+	if (bpf_core_field_exists(tp->bytes_received))
+		event->bytes_received = BPF_CORE_READ(tp, bytes_received);
+
 	gadget_submit_buf(ctx, &events, event, sizeof(*event));
 }
 
diff --git a/trace_tcp/ebpf/common.h b/trace_tcp/ebpf/common.h
