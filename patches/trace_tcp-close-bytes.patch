@@ -38,6 +38,8 @@ struct event {
 	gadget_errno error_raw;
 	int fd;
 	int accept_fd;
+	__u64 bytes_sent;
+	__u64 bytes_received;
 };
 
 struct tuple_key_t {
@@ -209,6 +211,8 @@ static __always_inline void fill_event(struct event *event,
 	event->error_raw = err;
 	event->fd = -1;
 	event->accept_fd = -1;
+	event->bytes_sent = 0;
+	event->bytes_received = 0;
 	if (proc)
 		event->proc = *proc;
 	else
